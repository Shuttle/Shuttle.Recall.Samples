{
  "ConnectionStrings": {
    "Azurite": "UseDevelopmentStorage=true;"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Error",
        "Shuttle": "Verbose"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "./logs/.log",
          "rollOnFileSizeLimit": true,
          "retainedFileCountLimit": 30,
          "fileSizeLimitBytes": 1048576,
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "Shuttle": {
    "Hopper": {
      "Inbox": {
        "WorkTransportUri": "azuresq://recall-samples/orders-server-work",
        "DeferredTransportUri": "azuresq://recall-samples/orders-server-deferred",
        "ErrorTransportUri": "azuresq://recall-samples/orders-error",
        "DurationToSleepWhenIdle": [
          "00:00:00.250"
        ]
      }
    }
  }
}